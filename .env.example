# ============================================
# AR-Core Platform - Environment Variables
# ============================================

# Database
DATABASE_URL=postgresql://arcore:arcore_secret@postgres:5432/arcore?schema=public
POSTGRES_USER=arcore
POSTGRES_PASSWORD=arcore_secret
POSTGRES_DB=arcore

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# API
API_PORT=4000
API_URL=http://localhost:4000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_PORT=3000

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# S3 (future)
# STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET=

# Rate Limiting
RATE_LIMIT_DRIVER=memory
# RATE_LIMIT_DRIVER=redis
# REDIS_URL=redis://redis:6379

# Platform
PLATFORM_NAME=AR-Core
DEFAULT_LOCALE=ar
